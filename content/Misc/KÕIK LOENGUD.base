filters:
  and:
    - file.folder.startsWith("04 - Õpetamine/")
    - file.basename != "index"
    - file.folder != "04 - Õpetamine/content/Misc"
properties:
  file.name:
    displayName: Loeng
views:
  - type: table
    name: KÕIK
    order:
      - jrk
      - publish
      - file.name
      - kodutöö
      - aine
      - file.folder
    sort:
      - property: aine
        direction: ASC
      - property: jrk
        direction: ASC
    columnSize:
      file.name: 343
      note.aine: 187
  - type: table
    name: Miksimine (1.osa)
    filters:
      and:
        - aine == link("Miksimine (1. osa)")
    order:
      - jrk
      - quartz
      - file.name
      - kodutöö
    sort:
      - property: jrk
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 421
      note.quartz: -693
  - type: table
    name: Miksimine (2.osa)
    filters:
      and:
        - aine == link("Miksimine (2. osa)")
    order:
      - jrk
      - file.name
  - type: table
    name: Miksimine (3.osa)
    filters:
      and:
        - aine == link("Miksimine (3. osa)")
    order:
      - jrk
      - quartz
      - file.name
    sort:
      - property: jrk
        direction: ASC
  - type: table
    name: Digitaalne Helitöötlus
    filters:
      and:
        - aine == link("Digitaalne Helitöötlus")
    order:
      - jrk
      - quartz
      - file.name
      - kodutöö
    sort:
      - property: jrk
        direction: ASC
    columnSize:
      note.antud: 5
  - type: table
    name: Stuudiotöö (1.osa)
    filters:
      and:
        - aine == link("Stuudiotöö (1. osa)")
    order:
      - jrk
      - quartz
      - file.name
      - kodutöö
    sort:
      - property: jrk
        direction: ASC
  - type: table
    name: Stuudiotöö (2.osa)
    filters:
      and:
        - aine == link("Stuudiotöö (2. osa)")
    order:
      - jrk
      - quartz
      - file.name
