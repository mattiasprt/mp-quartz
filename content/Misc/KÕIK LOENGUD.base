filters:
  and:
    - file.folder.startsWith("04 - Õpetamine/")
    - file.basename != "index"
    - file.folder != "04 - Õpetamine/content/Misc"
    - '!file.folder.startsWith("04 - Õpetamine/content/uldine")'
properties:
  file.name:
    displayName: Loeng
views:
  - type: table
    name: KÕIK
    order:
      - jrk
      - publish
      - file.name
      - kodutöö
      - aine
      - file.folder
    sort:
      - property: aine
        direction: ASC
      - property: jrk
        direction: ASC
    columnSize:
      file.name: 343
      note.aine: 187
  - type: table
    name: Miksimine (1.osa)
    filters:
      and:
        - aine == link("04 - Õpetamine/content/miksimine-1/index", "Miksimine 1")
    order:
      - jrk
      - publish
      - tehtud
      - file.name
      - kodutöö
    sort:
      - property: jrk
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.publish: 77
      file.name: 421
  - type: table
    name: Miksimine (2.osa)
    filters:
      and:
        - aine == link("Miksimine (2. osa)")
    order:
      - jrk
      - file.name
  - type: table
    name: Miksimine (3.osa)
    filters:
      and:
        - aine == link("04 - Õpetamine/content/miksimine-3/index", "Miksimine 3")
    order:
      - jrk
      - publish
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: jrk
        direction: ASC
    columnSize:
      note.publish: 6
  - type: table
    name: Digitaalne Helitöötlus
    filters:
      and:
        - aine == link("04 - Õpetamine/content/digitaalne-helitootlus/index", "Digitaalne Helitöötlus")
    order:
      - jrk
      - publish
      - tehtud
      - file.name
      - kodutöö
    sort:
      - property: jrk
        direction: ASC
    columnSize:
      note.publish: 78
  - type: table
    name: Stuudiotöö (1.osa)
    filters:
      and:
        - aine == link("04 - Õpetamine/content/stuudiotöö-1/index", "Stuudiotöö 1")
    order:
      - jrk
      - file.name
      - kodutöö
    sort:
      - property: jrk
        direction: ASC
  - type: table
    name: Stuudiotöö (2.osa)
    filters:
      and:
        - aine == link("04 - Õpetamine/content/stuudiotöö-2/index", "Stuudiotöö 2")
    order:
      - jrk
      - file.name
    sort:
      - property: jrk
        direction: ASC
      - property: file.name
        direction: ASC
