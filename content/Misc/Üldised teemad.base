filters:
  and:
    - file.name != "index"
views:
  - type: table
    name: posts
    filters:
      and:
        - file.folder == "04 - Õpetamine/content/uldine"
    order:
      - publish
      - file.name
  - type: table
    name: attachments
    filters:
      and:
        - file.folder == "04 - Õpetamine/content/uldine/attachments"
    order:
      - publish
      - file.name
